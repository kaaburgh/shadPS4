// Pattern verify/write/zero-check through storage buffer descriptors bound at
// arena offsets. Mirrors shadPS4's ObtainBuffer() -> descriptor path.

#version 460

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer Src {
    uint w[];
} src;

layout(set = 0, binding = 1, std430) buffer Dst {
    uint w[];
} dst;

layout(set = 0, binding = 2, std430) buffer Slot {
    uint mismatches;
    uint first_bad;
    uint first_value;
    uint checked;
} slot;

layout(push_constant, std430) uniform Params {
    uint count;
    uint seed_in;
    uint seed_out;
    uint mode;
} pc;

const uint MODE_VERIFY = 1u;
const uint MODE_WRITE = 2u;
const uint MODE_NONZERO = 4u;

uint pattern(uint i, uint seed) {
    uint x = i * 0x9E3779B9u + seed;
    x ^= x >> 16;
    x *= 0x7FEB352Du;
    x ^= x >> 15;
    x *= 0x846CA68Bu;
    x ^= x >> 16;
    return x;
}

void main() {
    const uint stride = gl_NumWorkGroups.x * 64u;
    uint checked = 0u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += stride) {
        if ((pc.mode & MODE_VERIFY) != 0u) {
            const uint v = src.w[i];
            checked++;
            if (v != pattern(i, pc.seed_in)) {
                atomicAdd(slot.mismatches, 1u);
                if (atomicMin(slot.first_bad, i) > i) {
                    slot.first_value = v;
                }
            }
        }
        if ((pc.mode & MODE_NONZERO) != 0u) {
            const uint v = src.w[i];
            checked++;
            if (v != 0u) {
                atomicAdd(slot.mismatches, 1u);
                if (atomicMin(slot.first_bad, i) > i) {
                    slot.first_value = v;
                }
            }
        }
        if ((pc.mode & MODE_WRITE) != 0u) {
            dst.w[i] = pattern(i, pc.seed_out);
        }
    }
    if (checked != 0u) {
        atomicAdd(slot.checked, checked);
    }
}
